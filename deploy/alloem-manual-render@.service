[Unit]
Description=AllOEMManuals isolated manual renderer on %i
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/alloemmanuals/manual-current
EnvironmentFile=/root/spotonauto.com/.env.local
EnvironmentFile=/etc/alloemmanuals/manual-delivery.env
Environment=NODE_ENV=production
Environment=PORT=%i
Environment=HOSTNAME=127.0.0.1
Environment=MANUAL_DATABASE_POOL_MAX=5
Environment=LOCAL_DATABASE_CONNECT_TIMEOUT_MS=1000
Environment=LOCAL_DATABASE_QUERY_TIMEOUT_MS=1500
Environment=NODE_OPTIONS=--max-old-space-size=2048
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p %i -H 127.0.0.1
Restart=always
RestartSec=2
TimeoutStopSec=15
CPUWeight=800
CPUQuota=150%
MemoryHigh=2G
MemoryMax=3G
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
